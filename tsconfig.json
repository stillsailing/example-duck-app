{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "jsx": "react",
    "target": "ES2015",
    "sourceMap": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@utils/*": ["src/utils/*"],
      "@layout/*": ["src/layout/*"],
      "@duck/*": ["src/duck/*"],
      "@hook/*": ["src/hook/*"],
      "@store": ["src/store/index"],
      "@store/*": ["src/store/*"],
    },
  },
  "include": ["src/**/*", "node_modules/@types/*"],
  "exclude": ["node_modules"]
}